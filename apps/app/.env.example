# Public links baked into the static build. Override locally in .env.local.
NEXT_PUBLIC_SITE_URL=https://seidar.xyz
NEXT_PUBLIC_DOCS_URL=https://docs.seidar.xyz
NEXT_PUBLIC_X_URL=https://x.com/droppolabs
# WalletConnect (Reown) project id from dashboard.reown.com. Enables phone wallets
# (Freighter / LOBSTR mobile). Leave empty to hide the WalletConnect option.
NEXT_PUBLIC_WC_PROJECT_ID=
