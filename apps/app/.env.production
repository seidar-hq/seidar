# Public links baked into the static build. Override locally in .env.local.
NEXT_PUBLIC_SITE_URL=https://seidar.xyz
NEXT_PUBLIC_DOCS_URL=https://docs.seidar.xyz
NEXT_PUBLIC_X_URL=https://x.com/droppolabs
# Seidar API (Cloudflare Worker, services/api).
NEXT_PUBLIC_API_URL=https://api.seidar.xyz
# Same Worker on workers.dev: used when a network can't reach api.seidar.xyz's addresses (lib/api.ts).
NEXT_PUBLIC_API_FALLBACK_URL=https://seidar-api.seidar-frontend.workers.dev

# Home (market overview) ships later: 0 keeps it out of production builds entirely (lib/features.ts).
NEXT_PUBLIC_ENABLE_HOME=0
