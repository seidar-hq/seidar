# Seidar API (services/api). Local dev: `npm run dev:api` from the repo root.
API_PORT=3002
# Optional: Redis cache (falls back to in-memory) and Postgres (falls back to the local mirror).
REDIS_URL=
DATABASE_URL=
# Public RPC default; point at a self-hosted/paid RPC to raise limits.
RPC_URL=https://mainnet.sorobanrpc.com
# CORS: comma-separated origins in prod (e.g. https://app.seidar.xyz); * for local dev.
CORS_ORIGINS=*
# Rate limit: requests per IP per route per window.
API_RL_LIMIT=120
API_RL_WINDOW_MS=60000
# Server-side keys (never shipped to the browser).
SOROSWAP_API_KEY=
DEFINDEX_API_KEY=
# Seidar swap fee: deployed seidar-router (unset = swaps carry no Seidar fee) and where fees are claimed to.
SEIDAR_ROUTER=
SEIDAR_FEE_ADDRESS=
SEIDAR_ROUTER_ADMIN_SECRET=

# Dev only: persist the in-memory cache to this file when Redis is not running
# (keeps DEX pair lists and charts warm across tsx watch restarts).
# CACHE_FILE=.cache/api-cache.json
