{
  "name": "seidar",
  "private": true,
  "version": "0.1.0",
  "description": "Seidar — DeFi position manager on Stellar",
  "workspaces": ["apps/*", "packages/*", "services/*", "mcp"],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:app": "npm run dev --workspace apps/app",
    "dev:docs": "npm run dev --workspace apps/docs",
    "test:sdk": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
